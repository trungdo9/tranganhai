# ==============================================================================
# ENTERPRISE MARKETING & AI OPERATIONS CREDENTIALS (.agents/.env.example)
# TRANG ANH AI — Hệ Thống AI Agent Vận Hành & Căn Chỉnh Luồng B2B
# ==============================================================================

# 1. EXA.AI DEEP RESEARCH & NEURAL KNOWLEDGE SEARCH
EXA_API_KEY=your_exa_api_key_here

# 2. SERPROBOT GOOGLE RANK TRACKING
SERPROBOT_API_KEY=your_serprobot_api_key_here
SERPROBOT_API_ENDPOINT=https://api.serprobot.com/v1/api.php?api_key=your_key
SERPROBOT_PROJECT_ID=your_project_id_here

# 3. BREVO (SENDINBLUE) EMAIL MARKETING
BREVO_API_KEY=your_brevo_api_key_here

# 4. MISA AMIS B2B CRM ENGINE
AMIS_API_KEY=your_amis_api_key_here
AMIS_APP_ID=antigravity

# 5. VIENEU TTS AI VOICEOVER ENGINE
VIENEU_TTS_TOKEN=your_vieneu_token_here

# 6. ZALO OFFICIAL ACCOUNT (OA) & NOTIFICATION
ZALO_OA_ID=your_zalo_oa_id_here
ZALO_OA_SERCRET=your_zalo_oa_secret_here
