# ============================================================================
# TRANG ANH AI — biến môi trường của web/ (Next.js)
# Copy file này thành `.env.local` để chạy ở máy, và khai đúng các biến dưới
# đây trong Vercel → Project → Settings → Environment Variables (Production).
# `.env` và `.env.*` đã bị .gitignore chặn — KHÔNG commit giá trị thật.
# ============================================================================

# Bắt buộc để form lead gửi được thông báo.
# Không có 2 biến này, /api/leads trả về 503 và lead KHÔNG được gửi đi đâu cả
# (đây là cấu hình cố ý: thà báo lỗi còn hơn báo thành công giả).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuỳ chọn — chỉ cần khi muốn lead rơi vào một topic trong nhóm forum.
# Để trống thì tin nhắn đi vào chính chat ở trên.
# Lấy id bằng Copy Link trong Telegram: https://t.me/c/<A>/<B> → thread = B.
TELEGRAM_THREAD_ID=
